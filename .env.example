# GEMINI_API_KEY: Required for Gemini AI API calls (used for production/paid tier).
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GROQ_API_KEY: Optional free-tier alternative for testing (no credit card required).
# Get one at https://console.groq.com/keys
# If set, the app tries Groq first, before Gemini, before the offline fallback.
GROQ_API_KEY=MY_GROQ_API_KEY

# GOOGLE_WEB_CLIENT_ID: Required for the "Sign in with Google" button.
# This is the *Web application* OAuth client ID (not the Android client), found in:
# Firebase Console -> Authentication -> Sign-in method -> Google -> Web SDK configuration,
# or Google Cloud Console -> APIs & Services -> Credentials.
GOOGLE_WEB_CLIENT_ID=MY_GOOGLE_WEB_CLIENT_ID
